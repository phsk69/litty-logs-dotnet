<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet package metadata so the webhook besties can yeet logs to chat 🪝 -->
    <IsPackable>true</IsPackable>
    <PackageId>LittyLogs.Webhooks</PackageId>
    <Description>webhook sink for litty-logs. yeets litty-fied logs to Slack incoming webhooks and Matrix hookshot rooms with safe payloads and maximum rizz no cap 🔥</Description>
    <PackageTags>logging;webhook;slack;matrix;hookshot;block-kit;emoji;gen-alpha;litty;notifications</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- let the test project peek at our internals bestie 🔍 -->
  <ItemGroup>
    <InternalsVisibleTo Include="LittyLogs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1*" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LittyLogs\LittyLogs.csproj" />
  </ItemGroup>

</Project>
