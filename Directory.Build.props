<Project>
  <!-- the one true version bestie — bump this and the whole squad levels up 🔥 -->
  <PropertyGroup>
    <Version>2.0.10</Version>
    <Authors>phsk69</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/phsk69/litty-logs-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/phsk69/litty-logs-dotnet</PackageProjectUrl>
    <!-- only src/ packages opt in — examples and tests stay unpackable by default -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Oldest to newest. Rotate GA channels according to the support policy in README.md. -->
    <LittyLogsSupportedFrameworks>net10.0;net11.0</LittyLogsSupportedFrameworks>
    <TargetFrameworks Condition="'$(LittyLogsFramework)' == ''">$(LittyLogsSupportedFrameworks)</TargetFrameworks>
    <TargetFramework Condition="'$(LittyLogsFramework)' != ''">$(LittyLogsFramework)</TargetFramework>
    <RestorePackagesWithLockFile Condition="'$(LittyLogsFramework)' == ''">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(LittyLogsFramework)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(LittyLogsFramework).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
