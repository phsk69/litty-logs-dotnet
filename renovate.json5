{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Copenhagen",
  "baseBranchPatterns": ["main"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageSuffix": " 🔥",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "nuget": {
    "ignorePaths": [
      "**/node_modules/**",
      "**/bower_components/**",
      "**/vendor/**",
      "**/__fixtures__/**"
    ],
    "rangeStrategy": "bump"
  },
  "packageRules": [
    {
      "description": "Only GA versions of Microsoft .NET release-train packages",
      "matchDatasources": ["nuget"],
      "matchPackageNames": ["Microsoft.Extensions.*", "Microsoft.AspNetCore.*"],
      "allowedVersions": "/^\\d+(?:\\.\\d+){1,3}(?:\\+[0-9A-Za-z.-]+)?$/"
    },
    {
      "description": "Only GA versions of the .NET SDK and runtime",
      "matchDatasources": ["dotnet-version"],
      "allowedVersions": "/^\\d+(?:\\.\\d+){1,3}(?:\\+[0-9A-Za-z.-]+)?$/"
    },
    {
      "description": "Major updates need a human bestie before they land",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
